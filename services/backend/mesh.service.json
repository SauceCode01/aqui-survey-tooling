{
  "contract": 1,
  "name": "backend",
  "owner": {
    "team": "api",
    "channel": "#api-oncall",
    "codeowners": "@org/api-team"
  },
  "runtime": {
    "portEnv": "PORT",
    "defaultPort": 3000,
    "health": {
      "path": "/health",
      "startPeriod": "15s"
    }
  },
  "provides": {
    "api": "backend-api",
    "version": "1.0.0"
  },
  "dependencies": {
    "filesystem": {
      "api": "filesystem-api",
      "range": "^1.0.0",
      "urlEnv": "FILESYSTEM_URL",
      "mock": {
        "service": "mock-filesystem"
      }
    }
  },
  "privateServices": [
    "firebase-emulator"
  ],
  "env": {
    "required": [
      "PORT"
    ],
    "buildArgs": []
  },
  "compose": {
    "base": ".docker/core/docker-compose.base.yml",
    "dev": ".docker/core/docker-compose.dev.yml",
    "prod": ".docker/core/docker-compose.prod.yml",
    "test": ".docker/core/docker-compose.test.yml",
    "standalone": ".docker/core/docker-compose.standalone.yml"
  },
  "commands": {
    "check": "make check-infra",
    "test": "make test"
  }
}
