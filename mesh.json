{
  "services": { 
    "filesystem": {
      "path": "./services/filesystem",
      "port": 3001,
      "replaceMocks": {},
      "envOverrides": {}
    },
    "backend": {
      "path": "./services/backend",
      "port": 3000,
      "replaceMocks": {
        "filesystem": "filesystem"
      },
      "envOverrides": {
        "FILESYSTEM_URL": "http://filesystem:3001"
      }
    },
    "frontend": {
      "path": "./services/frontend",
      "port": 8080,
      "replaceMocks": {
        "backend": "backend"
      },
      "envOverrides": {
        "BACKEND_URL": "http://backend:3000"
      }
    }
  }
}